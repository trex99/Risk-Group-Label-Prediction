* text=auto
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.png binary
*.svg text eol=lf

# Published manuscript artifacts are checksum-addressed. Preserve their exact
# bytes across Windows, macOS, and Linux checkouts.
figures/** -text
tables/** -text
revision/figures/** -text
revision/tables/** binary
